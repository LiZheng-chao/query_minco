<launch><arg name="audit_log"/><arg name="run_nonce"/><arg name="prefix" default="/p2" /><node pkg="nodelet" type="nodelet" args="standalone f0_controller_audit_pkg/AuditSO3ControlNodelet" name="f0_audit_position_controller" required="true" output="screen">
        <param name="so3_control/init_state_x" value="0.25" />
        <param name="so3_control/init_state_y" value="-0.25" />
        <param name="so3_control/init_state_z" value="2.0" />
        <remap from="~odom" to="$(arg prefix)/odom" />
        <remap from="~imu" to="$(arg prefix)/imu" />
        <remap from="~position_cmd" to="$(arg prefix)/position_cmd" />
        <remap from="~motors" to="$(arg prefix)/motors" />
        <remap from="~corrections" to="$(arg prefix)/corrections" />
        <remap from="~so3_cmd" to="$(arg prefix)/so3_raw" />
        <rosparam file="/home/lizheng/YOPO/Controller/src/so3_control/config/gains_hummingbird.yaml" />
        <rosparam file="/home/lizheng/YOPO/Controller/src/so3_control/config/corrections_hummingbird.yaml" />
        <param name="mass" value="0.98" />
        <param name="use_angle_corrections " value="false" />
        <param name="use_external_yaw " value="false" />
        <param name="gains/rot/z" value="1.0" />
        <param name="gains/ang/z" value="0.1" />
        <param name="record_log" value="true" /><param name="audit_run_nonce" value="$(arg run_nonce)" />
        <param name="PID_logger_file_name" value="$(arg audit_log)" />
  </node>
</launch>
