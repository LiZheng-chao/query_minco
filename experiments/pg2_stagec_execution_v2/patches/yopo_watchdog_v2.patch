+// Independent opt-in simulation watchdog. It never claims free-space or physical certification.
+Eigen::Vector3d NetworkControl::stagecEval(double t,int derivative) {
+    Eigen::Vector3d value=Eigen::Vector3d::Zero();
+    for(int k=derivative;k<6;k++){double f=1;for(int j=0;j<derivative;j++)f*=k-j;value+=stagec_coeff_.col(k)*f*std::pow(t,k-derivative);}return value;
+}
+double NetworkControl::stagecBernsteinBound(int derivative) {
+    const int n=5-derivative;double bound=0;
+    auto choose=[](int a,int b){double z=1;for(int j=1;j<=b;j++)z=z*(a-j+1)/j;return z;};
+    for(int k=0;k<=n;k++){Eigen::Vector3d v=Eigen::Vector3d::Zero();
+        for(int i=0;i<=k;i++){double f=1;for(int j=0;j<derivative;j++)f*=i+derivative-j;v+=stagec_coeff_.col(i+derivative)*f*std::pow(stagec_T_,i)*choose(k,i)/choose(n,i);}bound=std::max(bound,v.norm());}return bound;
+}
+void NetworkControl::stagecBuildBrake() {
+    stagec_profile_qualified_=false;
+    const bool state_ok=stagec_odom_seen_ && stagec_acc_valid_ &&
+      std::chrono::duration<double>(std::chrono::steady_clock::now()-stagec_odom_rx_).count()<=0.1 && cur_pos_.allFinite() && cur_vel_.allFinite() && stagec_acc_.allFinite();
+    if(state_ok) for(double T:{2.0,2.5,3.0,4.0}) {
+        stagec_T_=T;stagec_coeff_.setZero();stagec_coeff_.col(0)=cur_pos_;stagec_coeff_.col(1)=cur_vel_;stagec_coeff_.col(2)=stagec_acc_/2;
+        Eigen::Vector3d end=cur_pos_+cur_vel_*T/2+stagec_acc_*T*T/12;
+        Eigen::Matrix3d A;A<<T*T*T,std::pow(T,4),std::pow(T,5),3*T*T,4*T*T*T,5*std::pow(T,4),6*T,12*T*T,20*T*T*T;
+        Eigen::Matrix3d rhs;rhs.col(0)=end-stagecEval(T,0);rhs.col(1)=-stagecEval(T,1);rhs.col(2)=-stagecEval(T,2);
+        stagec_coeff_.rightCols<3>()=A.fullPivLu().solve(rhs.transpose()).transpose();
+        if(stagec_coeff_.allFinite() && stagecBernsteinBound(2)<=0.8 && stagecBernsteinBound(3)<=2.0){stagec_profile_qualified_=true;break;}
+    }
+    if(!stagec_profile_qualified_){stagec_coeff_.setZero();stagec_coeff_.col(0)=cur_pos_;stagec_T_=2.;stagec_reason_+="_UNQUALIFIED_HOLD_REQUEST";}
+}
+void NetworkControl::stagecWatchdog(const ros::WallTimerEvent&) {
+    if(!stagec_watchdog_enable_ || !is_simulation_ || !stagec_seen_ || !ctrl_valid_)return;
+    const auto now=std::chrono::steady_clock::now();
+    if(!stagec_latched_){
+        if(!stagec_force_ && std::chrono::duration<double>(now-stagec_rx_).count()<=0.1)return;
+        stagec_latched_=true;position_cmd_init_=true;stagec_start_=now;
+        if(stagec_reason_.empty())stagec_reason_="DOWNSTREAM_RECEIPT_TIMEOUT";
+        stagecBuildBrake();
+        ROS_WARN_STREAM("STAGEC_WATCHDOG_REQUEST "<<stagec_reason_<<" T="<<stagec_T_<<" reference_bound_a="<<stagecBernsteinBound(2)<<" reference_bound_j="<<stagecBernsteinBound(3));
+    }
+    double elapsed=std::chrono::duration<double>(now-stagec_start_).count(),t=std::min(elapsed,stagec_T_);
+    Eigen::Vector3d p=stagecEval(t,0),v=elapsed<stagec_T_?stagecEval(t,1):Eigen::Vector3d::Zero(),a=elapsed<stagec_T_?stagecEval(t,2):Eigen::Vector3d::Zero();
+    last_des_acc_=publishHoverSO3Command(p,v,a,cur_yaw_,0);
+    std_msgs::String message;std::ostringstream text;text.precision(17);
+    text<<"{\"reason\":\""<<stagec_reason_<<"\",\"elapsed\":"<<elapsed<<",\"duration\":"<<stagec_T_<<",\"bounded_reference\":"<<(stagec_profile_qualified_?"true":"false")<<",\"p\":["<<p.x()<<","<<p.y()<<","<<p.z()<<"],\"v\":["<<v.x()<<","<<v.y()<<","<<v.z()<<"],\"a\":["<<a.x()<<","<<a.y()<<","<<a.z()<<"],\"FALLBACK_VERIFIED\":false}";
+    message.data=text.str();stagec_watchdog_pub_.publish(message);
+}
